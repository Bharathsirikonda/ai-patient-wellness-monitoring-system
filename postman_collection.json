{
  "info": {
    "name": "AI-Enabled Patient Wellness Monitoring System API",
    "_postman_id": "wellness-system-v1-api",
    "description": "Production API Collection with sequential workflow for Auth, Patients, Wellness Logs, Analytics, Wellness Plans, and AI Insights.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "patientId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "recordId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "planId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 User Registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Dr. Alex Morgan\",\n  \"email\": \"alex.morgan@wellnessdemo.com\",\n  \"password\": \"HealthyPass2026!\",\n  \"role\": \"USER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "1.2 User Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('jwtToken', jsonData.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex.morgan@wellnessdemo.com\",\n  \"password\": \"HealthyPass2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "1.3 Get Current Authenticated User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Patient Management",
      "item": [
        {
          "name": "2.1 Create Patient Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('patientId', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Samantha Taylor\",\n  \"dateOfBirth\": \"1994-08-22\",\n  \"gender\": \"FEMALE\",\n  \"height\": 168.0,\n  \"weight\": 64.5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/patients",
              "host": ["{{baseUrl}}"],
              "path": ["patients"]
            }
          }
        },
        {
          "name": "2.2 Get All Patients For Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients",
              "host": ["{{baseUrl}}"],
              "path": ["patients"]
            }
          }
        },
        {
          "name": "2.3 Get Patient by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients/{{patientId}}",
              "host": ["{{baseUrl}}"],
              "path": ["patients", "{{patientId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Wellness Records & Logs",
      "item": [
        {
          "name": "3.1 Log Daily Wellness Record",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('recordId', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recordDate\": \"2026-11-16\",\n  \"sleepHours\": 7.5,\n  \"waterIntake\": 2400,\n  \"exerciseMinutes\": 45,\n  \"weight\": 64.2,\n  \"mood\": \"GOOD\",\n  \"energyLevel\": 8,\n  \"stressLevel\": 3,\n  \"notes\": \"Completed 45m moderate cycling and stayed hydrated throughout the day.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/patients/{{patientId}}/wellness-records",
              "host": ["{{baseUrl}}"],
              "path": ["patients", "{{patientId}}", "wellness-records"]
            }
          }
        },
        {
          "name": "3.2 Get Wellness Records for Patient",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients/{{patientId}}/wellness-records",
              "host": ["{{baseUrl}}"],
              "path": ["patients", "{{patientId}}", "wellness-records"]
            }
          }
        },
        {
          "name": "3.3 Get Recent Wellness History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients/{{patientId}}/wellness-records/recent?limit=7",
              "host": ["{{baseUrl}}"],
              "path": ["patients", "{{patientId}}", "wellness-records", "recent"],
              "query": [
                {
                  "key": "limit",
                  "value": "7"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Wellness Summaries & Statistics",
      "item": [
        {
          "name": "4.1 Weekly Wellness Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients/{{patientId}}/wellness-summary/weekly",
              "host": ["{{baseUrl}}"],
              "path": ["patients", "{{patientId}}", "wellness-summary", "weekly"]
            }
          }
        },
        {
          "name": "4.2 Monthly Wellness Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients/{{patientId}}/wellness-summary/monthly",
              "host": ["{{baseUrl}}"],
              "path": ["patients", "{{patientId}}", "wellness-summary", "monthly"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Wellness Plans",
      "item": [
        {
          "name": "5.1 Create Wellness Plan",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('planId', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Q4 Wellness Balance Goal\",\n  \"description\": \"Maintain optimal sleep schedule and aerobic consistency\",\n  \"dailyWaterTarget\": 2500,\n  \"dailySleepTarget\": 8.0,\n  \"weeklyExerciseTarget\": 180,\n  \"startDate\": \"2026-11-01\",\n  \"endDate\": \"2026-11-30\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/patients/{{patientId}}/wellness-plans",
              "host": ["{{baseUrl}}"],
              "path": ["patients", "{{patientId}}", "wellness-plans"]
            }
          }
        },
        {
          "name": "5.2 Track Plan Adherence Progress",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/wellness-plans/{{planId}}/progress",
              "host": ["{{baseUrl}}"],
              "path": ["wellness-plans", "{{planId}}", "progress"]
            }
          }
        },
        {
          "name": "5.3 Update Plan Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/wellness-plans/{{planId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["wellness-plans", "{{planId}}", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "6. AI Wellness Insights",
      "item": [
        {
          "name": "6.1 Generate AI Wellness Insight",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients/{{patientId}}/insights/generate",
              "host": ["{{baseUrl}}"],
              "path": ["patients", "{{patientId}}", "insights", "generate"]
            }
          }
        },
        {
          "name": "6.2 Get All Insights for Patient",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients/{{patientId}}/insights",
              "host": ["{{baseUrl}}"],
              "path": ["patients", "{{patientId}}", "insights"]
            }
          }
        }
      ]
    },
    {
      "name": "7. Health & Actuator",
      "item": [
        {
          "name": "7.1 System Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/actuator/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["actuator", "health"]
            }
          }
        }
      ]
    }
  ]
}
