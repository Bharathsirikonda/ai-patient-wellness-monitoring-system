# ==============================================================
# Environment Configuration Template (.env.example)
# AI-Enabled Patient Wellness Monitoring System
# Copy this file to .env and configure local/production values
# ==============================================================

# Server Configuration
PORT=8080

# Database Configuration (MySQL 8.x)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=patient_wellness_db
DB_USERNAME=wellness_user
DB_PASSWORD=wellness_pass

# Security & Stateless JWT Configuration
# MUST be at least 32 characters (256-bit key for HMAC-SHA256)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# AI / LLM Integration Configuration
# Provider Options: FALLBACK or OPENAI
LLM_PROVIDER=FALLBACK
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
